# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Paul's working notes folder — may contain real test/live API keys pasted in
# for reference (PDFs, xlsx, .txt). Keep the whole folder ignored EXCEPT the
# curated Process Repository doc, which the "Create Project Diagrams from .md"
# tool consumes and which is verified secret-free.
/new features/*
!/new features/Process Repository Final.md
!/new features/Process Repository v2 — Plan.md

# The GETAI partner-API plan. The FOLDER has to be un-ignored before a file
# inside it can be — git cannot re-include a file whose parent directory is
# excluded — so: un-ignore the folder, re-ignore its contents, then except the
# one document. The call transcript and the generated .docx stay ignored.
!/new features/getai-api/
/new features/getai-api/*
!/new features/getai-api/Partner API Plan.md

# Playwright e2e artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# Generated by npm run ai:report (live AI conformance log)
/ai-conformance-report.md
/ai-model-compare.md
