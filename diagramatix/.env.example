# Diagramatix — environment variables reference.
#
# Copy this file to `.env` (local dev) and fill in real values. In
# production these are sourced from Azure Key Vault and surfaced as App
# Service application settings — never committed.
#
# `.gitignore` and `.dockerignore` both keep `.env*` out of the repo /
# image; only this `.env.example` is whitelisted.

# ── Database ──────────────────────────────────────────────────────────────
# Local dev: postgres on localhost. Production (Azure PG Flex Server)
# requires `?sslmode=require` on the connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/diagramatix"

# ── Auth.js (next-auth v5 beta) ───────────────────────────────────────────
# AUTH_SECRET signs the JWTs. Generate a fresh value with:
#   openssl rand -base64 32
# A weak or shared secret silently lets anyone forge a session, so rotate
# this whenever you suspect leakage.
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"

# Required when the app sits behind a reverse proxy (Next.js standalone
# in a container behind Azure App Service). Without this, Auth.js
# discards X-Forwarded-* headers and the OAuth callback URL falls back
# to http://localhost.
AUTH_TRUST_HOST=true

# Session lifetime (seconds). Optional — defaults to a 7-day absolute cap with a
# daily rolling refresh. Tighten for enterprise (e.g. 28800 = 8h) via env.
# AUTH_SESSION_MAX_AGE=604800
# AUTH_SESSION_UPDATE_AGE=86400

# Optional — restrict SELF-registration to these email domains (comma-separated).
# When set, anyone outside the list is provisioned by an admin / SSO instead.
# REGISTRATION_ALLOWED_DOMAINS="acme.com,acme.co.uk"

# Full origin the browser hits. Used for OAuth callback URLs and email
# verification links. Local: http://localhost:3000. Production:
# https://app.diagramatix.com.au
NEXTAUTH_URL="http://localhost:3000"

# ── Microsoft Entra ID (Azure AD) — SharePoint integration ────────────────
# Register ONE App in the Entra portal, used for both flows:
#   • Login "Sign in with Microsoft" — stays SINGLE tenant (issuer uses
#     AZURE_TENANT_ID below); redirect URI = NEXTAUTH_URL +
#     `/api/auth/callback/microsoft-entra-id`.
#   • "Connect SharePoint" (bring-your-own, any org) — set the app's
#     Supported account types to MULTITENANT ("any organizational directory")
#     and add a second redirect URI = <origin> + `/api/microsoft/callback`
#     (add both http://localhost:3000/... and the prod host).
#   Delegated perms: `Files.ReadWrite.All`, `Sites.Read.All`, `offline_access`,
#   `openid/profile/email`. Each connecting org's admin grants consent once.
#   Copy IDs and a client secret VALUE (not the secret ID) below. Secrets
#   expire — calendar the rotation date.
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET="replace-with-entra-client-secret-value"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Encrypts per-user SharePoint (Graph) access+refresh tokens at rest on the
# MicrosoftConnection table (AES-256-GCM). MUST decode to 32 bytes. Generate:
#   openssl rand -base64 32
# Dedicated key (NOT AUTH_SECRET) so rotating the session secret never bricks
# stored tokens. Rotating THIS key invalidates connections (users reconnect).
MS_TOKEN_ENC_KEY="replace-with-openssl-rand-base64-32-output"

# ── Admin elevation password ──────────────────────────────────────────────
# Optional. Allows non-superuser callers to create built-in templates by
# supplying this value in the request body. Superusers (listed in
# SUPERUSER_EMAILS) don't need it. Empty / unset = elevation disabled.
ADMIN_PASSWORD="replace-with-something-only-the-admin-knows"

# ── SMTP — password reset emails ──────────────────────────────────────────
# Diagramatix sends from a Microsoft 365 mailbox on diagramatix.com.au.
# The mailbox must have "Authenticated SMTP" enabled in the Exchange admin
# centre (Users → mailbox → Mail → Manage email apps → tick Authenticated
# SMTP). If MFA is enforced on the mailbox, generate an app password at
# aka.ms/MFASetup and use that as SMTP_PASS instead of the real password.
#
# Office 365 SMTP relay: smtp.office365.com on port 587 with STARTTLS
# (SMTP_SECURE=false — STARTTLS is negotiated mid-session, not implicit).
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="support@diagramatix.com.au"
SMTP_PASS="replace-with-mailbox-or-app-password"
SMTP_FROM="support@diagramatix.com.au"

# ── Anthropic Claude API — AI-assisted BPMN generation ────────────────────
# Get a key at https://console.anthropic.com → Settings → API Keys.
# Workspace keys are preferred over personal keys (scoped billing).
ANTHROPIC_API_KEY="sk-ant-api03-replace-with-real-key"
# Optional — route ALL Claude traffic through an enterprise proxy / private
# gateway / region-pinned or self-hosted endpoint (data-residency + egress
# control). Leave unset to use Anthropic's default endpoint (api.anthropic.com).
# ANTHROPIC_BASE_URL="https://your-gateway.example.com"
# Optional — on-prem / local models. Point ANTHROPIC_BASE_URL at a local
# Anthropic-compatible gateway (e.g. LiteLLM in front of vLLM/Ollama) and list the
# local model id(s) here so they appear in the AI-Generate model picker and can be
# selected as the default. Comma-separated "id|Label" (or bare id). Multimodal
# model needed if you use image/PDF-to-diagram.
# AI_CUSTOM_MODELS="llama-3.3-70b|Llama 3.3 70B (local),qwen2.5-vl-72b|Qwen2.5-VL 72B (local)"
# Optional — retain the raw prompt text in the SuperAdmin model-comparison result
# (Diagram.aiComparison). Off by default (only the prompt length is kept) so
# customer prompt content isn't persisted. Set to 1 to keep the text for debugging.
# AI_COMPARE_STORE_PROMPT=1

# ── Moonshot AI (Kimi) — an alternative, choosable AI provider ─────────────
# Kimi is reached via its ANTHROPIC-COMPATIBLE endpoint, so Diagramatix reuses the
# same SDK + Messages API — Kimi models just appear alongside Claude in the
# SuperAdmin "AI Generate Model" picker (and in "Compare all models"). They surface
# ONLY when this key is set. Get a key at https://platform.moonshot.ai.
# MOONSHOT_API_KEY="sk-replace-with-real-moonshot-key"
# Optional — the Kimi models to offer. Comma-separated "id|Label" (or bare id).
# Unset → a curated default list (kimi-latest, kimi-k2, moonshot-v1-128k [+vision]).
# MOONSHOT_MODELS="kimi-latest|Kimi Latest,moonshot-v1-128k-vision-preview|Kimi 128k (vision)"
# Optional — endpoint. Defaults to the INTERNATIONAL endpoint below; use the .cn
# host for mainland China (note: data is then processed in China — residency).
# MOONSHOT_BASE_URL="https://api.moonshot.ai/anthropic"   # or https://api.moonshot.cn/anthropic

# ── Google Gemini (optional) ────────────────────────────────────────────────
# Gemini is NOT Anthropic-Messages-API native, so — unlike Kimi — it needs an
# ANTHROPIC-COMPATIBLE GATEWAY in front of it that translates /v1/messages ⇄
# Gemini (e.g. LiteLLM Proxy holding your Google AI Studio / Vertex key). Point
# GOOGLE_BASE_URL at that gateway and GOOGLE_API_KEY at the gateway's key. Gemini
# models surface in the picker (and "Compare all models") ONLY when BOTH are set.
# GOOGLE_API_KEY="sk-replace-with-gateway-key"
# GOOGLE_BASE_URL="http://litellm.internal:4000"          # your Anthropic-compatible gateway
# Optional — the Gemini models to offer (use the EXACT ids your gateway exposes).
# Comma-separated "id|Label" (or bare id). Unset → gemini-2.5-pro, gemini-2.5-flash.
# GOOGLE_MODELS="gemini-2.5-pro|Gemini 2.5 Pro,gemini-2.5-flash|Gemini 2.5 Flash"

# ── Microsoft — Azure OpenAI (GPT / o-series) + Phi (optional) ───────────────
# Like Gemini, these speak the OpenAI shape, so they need an ANTHROPIC-COMPATIBLE
# GATEWAY (the same LiteLLM proxy can front Azure OpenAI + Phi). Point
# MICROSOFT_BASE_URL at the gateway and MICROSOFT_API_KEY at the gateway's key. The
# models surface in the picker (and Compare) ONLY when BOTH are set. NOTE: these are
# DISTINCT from the AZURE_* SharePoint/Entra vars above — different purpose.
# MICROSOFT_API_KEY="sk-replace-with-gateway-key"
# MICROSOFT_BASE_URL="http://litellm.internal:4000"       # your Anthropic-compatible gateway
# Optional — models to offer (use the EXACT model/deployment names your gateway
# exposes). Comma-separated "id|Label". Unset → gpt-4o, gpt-4o-mini, phi-4.
# MICROSOFT_MODELS="gpt-4o|GPT-4o,gpt-4o-mini|GPT-4o mini,phi-4|Phi-4"

# ── Deepgram — real-time voice dictation in the AI panels ──────────────────
# Get a key at https://console.deepgram.com → API Keys (Member/Owner key).
# The server mints a short-lived temp key per session so the browser streams
# straight to Deepgram without seeing this master key. If unset, dictation
# falls back to the browser's built-in speech engine.
DEEPGRAM_API_KEY=""

# ── Liveblocks — Phase 2 real-time co-authoring (live cursors) ─────────────
# Set this SECRET key to turn live cursors ON (nothing else needed — the diagram
# page detects it server-side and enables the client wiring; no rebuild). Get it
# from a Liveblocks project (liveblocks.io → dashboard → your project → API keys →
# secret key, "sk_..."). Server-only: the /api/collab/token route mints
# room-scoped tokens with it (gated by the caller's diagram access) and the
# browser talks to Liveblocks directly. Unset → editor runs Phase 1 (polled
# presence) unchanged. In prod it lives in Key Vault / App Settings.
LIVEBLOCKS_SECRET_KEY=""

# ── Stripe — self-serve subscriptions ─────────────────────────────────────
# Test keys come from Stripe Dashboard → Developers → API Keys with the
# Test Mode toggle ON. Webhook secret is from Developers → Webhooks →
# (your endpoint) → Reveal signing secret, OR from `stripe listen` output
# during local dev (starts with `whsec_`). NEXT_PUBLIC_ key is safe to
# expose to the browser — that's the publishable key, not the secret.
# Flip these to live-mode counterparts (sk_live_*, pk_live_*, separate
# whsec_) for the production rollout step.
STRIPE_SECRET_KEY="sk_test_replace-with-real-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-after-running-stripe-listen-or-creating-endpoint"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-real-key"
