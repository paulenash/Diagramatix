    <!-- ================= A DELIBERATELY BROKEN MODEL ================= -->
    <!-- Three violations on purpose, so the refusals can be seen working:
           E3  an event followed by an XOR split (an event cannot decide)
           E5  an XOR split with no matching join
           E7  one function assigned to two organisational units
         Real ARIS repositories are full of exactly this. -->
    <ObjDef ObjDef.ID="ObjDef.BE1" TypeNum="OT_EVT" SymbolNum="ST_EV">
      <AttrDef AttrDef.Type="AT_NAME"><AttrValue LocaleId="1033">Complaint received</AttrValue></AttrDef>
